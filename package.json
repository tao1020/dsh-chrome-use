{
  "name": "dsh-chrome-use",
  "version": "0.1.2",
  "description": "Control Google Chrome tabs from DeepSeek Harness.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "extension",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "PRIVACY.md",
    "scripts/build-client.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs",
    "dev": "node scripts/dev.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "npm run build:client"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tao1020/dsh-chrome-use.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
